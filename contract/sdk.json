{
  "API_VERSION": "1.0.0",
  "CONTRAT_SOURCE": "https://spavik-gateway-test-bnp1bedb.ew.gateway.dev",
  "OPERATIONS": {
    "train": {
      "method": "POST",
      "path": "/v1/models",
      "billable": false,
      "cost": "0",
      "idempotent": true,
      "timeout": 120.0,
      "idempotency_declared_in_contract": true
    },
    "predict": {
      "method": "POST",
      "path": "/v1/models/{id}/predict",
      "billable": true,
      "cost": "1 par ligne",
      "idempotent": true,
      "timeout": 30.0,
      "idempotency_declared_in_contract": true
    },
    "forecast": {
      "method": "POST",
      "path": "/v1/forecast",
      "billable": true,
      "cost": "horizon per call, all series included",
      "idempotent": true,
      "timeout": 60.0,
      "idempotency_declared_in_contract": true
    },
    "submit_outcomes": {
      "method": "POST",
      "path": "/v1/models/{id}/outcomes",
      "billable": false,
      "cost": "0",
      "idempotent": true,
      "timeout": 30.0,
      "idempotency_declared_in_contract": true
    },
    "refresh": {
      "method": "POST",
      "path": "/v1/models/{id}/refresh",
      "billable": false,
      "cost": "0",
      "idempotent": true,
      "timeout": 120.0,
      "idempotency_declared_in_contract": true
    },
    "list_models": {
      "method": "GET",
      "path": "/v1/models",
      "billable": false,
      "cost": "0",
      "idempotent": false,
      "timeout": 15.0,
      "idempotency_declared_in_contract": false
    },
    "performance": {
      "method": "GET",
      "path": "/v1/models/{id}/performance",
      "billable": false,
      "cost": "0",
      "idempotent": false,
      "timeout": 30.0,
      "idempotency_declared_in_contract": false
    }
  },
